    "blessing_001": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나쁜 기운은 물러가고 평안이 깃들기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May ill fortune pass and peace remain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厄が去り、穏やかな日々が訪れますように。"
          }
        }
      }
    },
    "blessing_002": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가는 곳마다 무탈하고 돌아오는 길도 평안하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May you travel safely and return in peace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行く先々で無事に過ごし、安らかに帰れますように。"
          }
        }
      }
    },
    "blessing_003": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집 안에 평안이 머물고 근심이 멀어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May peace fill your home and worries fade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家に安らぎが満ち、心配ごとが遠のきますように。"
          }
        }
      }
    },
    "blessing_004": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸과 마음이 늘 건강하고 편안하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your body and mind be well and at ease."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心も体も健やかで、穏やかに過ごせますように。"
          }
        }
      }
    },
    "blessing_005": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜻밖의 어려움도 무사히 지나가기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May you come safely through unexpected trials."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いがけない困難も無事に乗り越えられますように。"
          }
        }
      }
    },
    "blessing_006": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사랑하는 이들이 어디서나 무탈하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May those you love be safe wherever they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な人たちが、どこにいても無事でありますように。"
          }
        }
      }
    },
    "blessing_007": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤에는 깊이 쉬고 아침에는 가뿐히 일어나기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May you sleep deeply and wake refreshed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜はぐっすり眠り、朝はすっきり目覚められますように。"
          }
        }
      }
    },
    "blessing_008": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흔들리는 순간에도 마음의 중심을 지키기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your heart stay steady in uncertain times."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心が揺れるときも、自分を見失わずにいられますように。"
          }
        }
      }
    },
    "blessing_009": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궂은일은 비켜가고 좋은 기운이 함께하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May misfortune pass you by and good fortune stay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "災いを避け、幸運に恵まれますように。"
          }
        }
      }
    },
    "blessing_010": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머무는 자리마다 따뜻한 기운이 깃들기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May warmth surround you wherever you stay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこにいても、温かな気に包まれますように。"
          }
        }
      }
    },
    "blessing_011": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 길에도 가까운 길에도 평안이 함께하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May peace accompany every journey, near or far."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くへも近くへも、道中が穏やかでありますように。"
          }
        }
      }
    },
    "blessing_012": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘도 내일도 별 탈 없이 평온하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May today and tomorrow pass in quiet peace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日も明日も、何事もなく穏やかに過ごせますように。"
          }
        }
      }
    },
    "blessing_013": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바라는 일이 순조롭게 이루어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your wishes come true with ease."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "願いごとが順調にかないますように。"
          }
        }
      }
    },
    "blessing_014": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정성 들인 일에 좋은 결실이 맺히기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your care and effort bear good fruit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心を込めた努力が、よい実を結びますように。"
          }
        }
      }
    },
    "blessing_015": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재물은 모이고 살림은 넉넉해지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May prosperity grow and your home know plenty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "財に恵まれ、暮らしが豊かになりますように。"
          }
        }
      }
    },
    "blessing_016": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 기회가 알맞은 때에 찾아오기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the right opportunity arrive at the right time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よい機会が、ふさわしいときに訪れますように。"
          }
        }
      }
    },
    "blessing_017": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 시작하는 일에 밝은 길이 열리기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May a bright path open with each new beginning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たな始まりに、明るい道が開けますように。"
          }
        }
      }
    },
    "blessing_018": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "막혀 있던 일이 풀리고 앞길이 트이기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May obstacles clear and the way ahead open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "滞っていた物事が動き出し、道が開けますように。"
          }
        }
      }
    },
    "blessing_019": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래 품은 소망이 마침내 꽃피기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your long-held hopes finally bloom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長く抱いてきた願いが、ついに花開きますように。"
          }
        }
      }
    },
    "blessing_020": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배운 것이 깊어지고 노력한 만큼 빛나기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your learning deepen and your efforts shine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学びが深まり、努力が輝きますように。"
          }
        }
      }
    },
    "blessing_021": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 순간에 준비한 실력을 펼치기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your preparation shine when it matters most."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な場面で、培った力を発揮できますように。"
          }
        }
      }
    },
    "blessing_022": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택의 갈림길마다 지혜가 함께하기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May wisdom guide you at every crossroads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択のたびに、知恵に導かれますように。"
          }
        }
      }
    },
    "blessing_023": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 복이 쌓여 큰 기쁨으로 돌아오기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May small blessings gather into lasting joy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな幸せが重なり、大きな喜びとなりますように。"
          }
        }
      }
    },
    "blessing_024": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하는 일마다 좋은 인연과 기회가 이어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May all you do bring good company and opportunity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り組むことすべてに、よいご縁と機会がありますように。"
          }
        }
      }
    },
    "blessing_025": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋은 인연은 가까워지고 오래 이어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May good connections find you and endure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よいご縁に恵まれ、末永く続きますように。"
          }
        }
      }
    },
    "blessing_026": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로를 아끼는 마음이 깊어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your care for one another grow deeper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互いを大切に思う心が、深まりますように。"
          }
        }
      }
    },
    "blessing_027": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소중한 사람과 웃음을 나누는 날이 많아지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May you share more laughter with those you cherish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大切な人と笑い合う日が、増えますように。"
          }
        }
      }
    },
    "blessing_028": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음에 쌓인 근심이 가볍게 흩어지기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May the worries in your heart gently fade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心に積もった悩みが、そっとほどけますように。"
          }
        }
      }
    },
    "blessing_029": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리 있는 이에게도 따뜻한 마음이 닿기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May your warmth reach those far away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くにいる人にも、温かな思いが届きますように。"
          }
        }
      }
    },
    "blessing_030": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서운함은 풀리고 다정한 말이 오가기를."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May hurt feelings heal and kind words flow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "わだかまりが解け、優しい言葉を交わせますように。"
          }
        }
      }
    },
    "blessing_031": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지친 마음에 다시 나아갈 힘이 깃들기를."
